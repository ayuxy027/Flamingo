{
  "name": "@ayuxy027/flamingo",
  "version": "0.1.0",
  "description": "Unblind your agent. AI-native browser automation on Bun.WebView, with zero dependencies.",
  "type": "module",
  "module": "flamingo.ts",
  "main": "flamingo.ts",
  "types": "flamingo.ts",
  "exports": {
    ".": "./flamingo.ts"
  },
  "bin": {
    "flamingo": "./flamingo.ts"
  },
  "files": [
    "flamingo.ts",
    "README.md",
    "STDLIB.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun build --compile --minify --sourcemap=none flamingo.ts --outfile dist/flamingo",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "proof": "bun run scripts/dependency-proof.ts",
    "verify:build": "bun run scripts/verify-reproducible.ts"
  },
  "keywords": [
    "bun",
    "webview",
    "browser-automation",
    "e2e",
    "mcp",
    "ai-agent",
    "cdp"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.0"
  }
}
