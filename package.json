{
  "name": "tryflamingo",
  "version": "0.1.2",
  "description": "AI-native alternative to Playwright and Puppeteer. One file, zero dependencies, Bun.",
  "type": "module",
  "module": "flamingo.ts",
  "main": "flamingo.ts",
  "types": "flamingo.ts",
  "exports": {
    ".": "./flamingo.ts"
  },
  "bin": {
    "flamingo": "./flamingo.ts",
    "tryflamingo": "./flamingo.ts"
  },
  "files": [
    "flamingo.ts",
    "docs/api.md",
    "docs/cli.md",
    "docs/mcp-tools.md",
    "docs/internals.md",
    "skills",
    "mcp",
    "README.md",
    "STDLIB.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun build --compile --minify --sourcemap=none flamingo.ts --outfile dist/flamingo",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "proof": "bun run scripts/dependency-proof.ts",
    "verify:build": "bun run scripts/verify-reproducible.ts",
    "docs": "bun run scripts/generate-docs.ts",
    "docs:check": "bun run scripts/generate-docs.ts --check",
    "website": "bun run scripts/serve-website.ts"
  },
  "keywords": [
    "bun",
    "webview",
    "browser-automation",
    "e2e",
    "mcp",
    "ai-agent",
    "cdp"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayuxy027/flamingo.git"
  },
  "homepage": "https://github.com/ayuxy027/flamingo#readme"
}
